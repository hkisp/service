# IDCX AI Chat — copy to .env.local and fill in ONLY the keys you use.
# NEVER put real keys in this file, and never commit .env.local.

# Default model (must be a modelId from lib/ai/registry.ts)
IDCX_DEFAULT_MODEL=openai-gpt-5-mini

# --- Mode B: per-provider keys (server-only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Mode B: OpenAI-compatible custom endpoint ---
# Must be a public https:// URL. Private / localhost / 10.x / 192.168.x /
# 172.16-31.x / ::1 / *.local URLs are rejected by the SSRF guard.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Mode A: unified AI Gateway (OpenAI-compatible) ---
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional env overrides for example registry model IDs (confirm in provider docs)
OPENAI_MODEL=
ANTHROPIC_MODEL=
GOOGLE_MODEL=

# --- Supabase (optional; without these the app runs in DEMO mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- TEST ONLY: mock provider. Never set to 1 in production. ---
IDCX_MOCK_MODEL=0
